# Firebase Configuration (valeurs publiques - remplacer par les vôtres si autre projet)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain_here
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# Mock Database (mettre à true pour utiliser les données fictives sans affecter la base en ligne)
# VITE_USE_MOCK_DB=true

# Stripe Configuration (clé publique - remplacer par la vôtre)
VITE_STRIPE_PUBLISHABLE_KEY="your_stripe_publishable_key_here"

# FedaPay Configuration (clé publique - remplacer par la vôtre)
# Obtenez votre clé publique depuis votre tableau de bord FedaPay
VITE_FEDAPAY_PUBLIC_KEY="your_fedapay_public_key_here"

# YouTube Data API v3 (frontend POC - clé publique restreinte par HTTP referrer
# dans Google Cloud Console > APIs & Services > Credentials)
# Sans clé: l'écran /manage-youtube affiche un avertissement et la récupération est désactivée.
VITE_YOUTUBE_API_KEY="your_youtube_api_key_here"