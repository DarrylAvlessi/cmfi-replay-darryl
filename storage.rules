rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Users can read/write their own avatar files
    match /avatars/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Anyone can read avatar files (for profile display)
    match /avatars/{userId}/{fileName} {
      allow read: if true;
    }

    // YouTube custom season covers: public read, admin write.
    // Admin flag lives on the users/{uid} Firestore doc (isAdmin).
    function isAdmin() {
      return request.auth != null &&
        get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    match /youtube/seasons/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    
    // Default deny for all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
